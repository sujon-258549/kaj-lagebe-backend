generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String
  mobile             String             @unique
  role               Role               @default(USER)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  isActive           Boolean            @default(true)
  isBlocked          Boolean            @default(false)
  isDeleted          Boolean            @default(false)
  isVerified         Boolean            @default(false)
  passwordChangeTime DateTime?
  passwordChanged    Boolean            @default(false)
  lastLogin          DateTime?          @default(now())
  subscriptionId     String?
  address            Address?
  profile            Profile?
  subscriptionEarns  SubscriptionEarn[]
  subscription       Subscription?      @relation(fields: [subscriptionId], references: [id])
  workInfo           WorkInfo?
}

model Profile {
  id            String      @id @default(uuid())
  mobile        String      @unique
  name          String?
  gender        Gender?
  age           Int?
  dob           DateTime?
  bloodGroup    BloodGroup?
  photo         String?
  nid           String?
  nidPhoto      String[]    @default([])
  emailVerified Boolean     @default(false)
  phoneVerified Boolean     @default(false)
  nidVerified   Boolean     @default(false)
  serialId      String?
  user          User        @relation(fields: [mobile], references: [mobile])
}

model Address {
  id       String  @id @default(uuid())
  mobile   String  @unique
  division String?
  district String?
  upazila  String?
  address  String?
  user     User    @relation(fields: [mobile], references: [mobile])
}

model WorkInfo {
  id                 String    @id @default(uuid())
  mobile             String    @unique
  categories         String[]  @default([])
  experience         String?
  workType           String?
  availableTime      String?
  idDeleted          Boolean   @default(false)
  isBlocked          Boolean   @default(false)
  passwordChangeTime DateTime?
  passwordChanged    Boolean   @default(false)
  verified           Boolean   @default(false)
  user               User      @relation(fields: [mobile], references: [mobile])
}

model SubscriptionEarn {
  id             String    @id @default(uuid())
  userId         String
  subscriptionId String
  amount         String
  expireAt       DateTime
  isActive       Boolean   @default(true)
  isExpired      Boolean   @default(false)
  renewAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id])
}

model Otp {
  id        String   @id @default(uuid())
  email     String   @unique
  otpToken  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id            String        @id @default(uuid())
  icon          String?
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  name          String
  slug          String        @unique
  status        Boolean       @default(true)
  subCategories SubCategory[]
}

model SubCategory {
  id          String   @id @default(uuid())
  name        String
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  icon        String?
  slug        String   @unique
  status      Boolean  @default(true)
  category    Category @relation(fields: [categoryId], references: [id])

  @@map("sub_categories")
}

model Blog {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String
  description String?
  excerpt     String?
  coverImage  String?
  tags        String[]  @default([])
  category    String?
  authorId    String?
  authorName  String?
  authorImage String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Subscription {
  id           String   @id @default(uuid())
  name         String
  price        String
  discount     String
  isRecomended Boolean  @default(false)
  featured     String[] @default([])
  isActive     Boolean  @default(true)
  status       Boolean  @default(true)
  description  String?
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  duration     String
  slug         String   @unique
  activeDays   Int
  users        User[]
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  parentId  String?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id])
  children  Folder[] @relation("FolderToFolder")
  images    Image[]
}

model Image {
  id        String   @id @default(uuid())
  name      String
  url       String
  folderId  String?
  slug      String   @unique
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  folder    Folder?  @relation(fields: [folderId], references: [id])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MAINTAINER
  OWNER
  USER
  WORKER
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}
