generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String
  mobile             String             @unique
  role               Role               @default(USER)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  isActive           Boolean            @default(true)
  isBlocked          Boolean            @default(false)
  isDeleted          Boolean            @default(false)
  isVerified         Boolean            @default(false)
  passwordChangeTime DateTime?
  passwordChanged    Boolean            @default(false)
  lastLogin          DateTime?          @default(now())
  subscriptionId     String?
  loginCount         Int                @default(0)
  loginTryCount      Int                @default(0)
  loginTryTime       DateTime?          @default(now())
  address            Address?
  profile            Profile?
  subscriptionEarns  SubscriptionEarn[]
  subscription       Subscription?      @relation(fields: [subscriptionId], references: [id])
  workInfo           WorkInfo?
  jobs               Job[]
  applications       Application[]
  comments           Comment[]
  notifications      Notification[]
  payments           Payment[]

  @@map("users")
}

model Profile {
  id            String      @id @default(uuid())
  mobile        String      @unique
  name          String?
  gender        Gender?
  age           Int?
  dob           DateTime?
  bloodGroup    BloodGroup?
  photo         String?
  nid           String?
  nidPhoto      String[]    @default([])
  emailVerified Boolean     @default(false)
  phoneVerified Boolean     @default(false)
  nidVerified   Boolean     @default(false)
  serialId      String?
  user          User        @relation(fields: [mobile], references: [mobile])
}

model Address {
  id       String  @id @default(uuid())
  mobile   String  @unique
  division String?
  district String?
  upazila  String?
  address  String?
  user     User    @relation(fields: [mobile], references: [mobile])

  @@map("addresses")
}

model WorkInfo {
  id                 String    @id @default(uuid())
  mobile             String    @unique
  categories         String[]  @default([])
  experience         String?
  workType           String?
  availableTime      String?
  isDeleted          Boolean   @default(false)
  isBlocked          Boolean   @default(false)
  passwordChangeTime DateTime?
  passwordChanged    Boolean   @default(false)
  verified           Boolean   @default(false)
  user               User      @relation(fields: [mobile], references: [mobile])

  @@map("work_infos")
}

model SubscriptionEarn {
  id             String       @id @default(uuid())
  userId         String
  subscriptionId String
  amount         String
  expireAt       DateTime
  isActive       Boolean      @default(true)
  isExpired      Boolean      @default(false)
  renewAt        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id])
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("subscription_earns")
}

model Payment {
  id                 String        @id @default(cuid())
  transactionId      String        @unique
  amount             Float
  status             PaymentStatus @default(PENDING)
  paymentMethod      String?
  userId             String
  subscriptionId     String
  user               User          @relation(fields: [userId], references: [id])
  subscription       Subscription  @relation(fields: [subscriptionId], references: [id])
  paymentGatewayData Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("payments")
}

model Otp {
  id        String   @id @default(uuid())
  email     String   @unique
  otpToken  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otps")
}

model Category {
  id            String        @id @default(uuid())
  icon          String?
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  name          String
  slug          String        @unique
  status        Boolean       @default(true)
  subCategories SubCategory[]
  jobs          Job[]

  @@map("categories")
}

model SubCategory {
  id          String   @id @default(uuid())
  name        String
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  icon        String?
  slug        String   @unique
  status      Boolean  @default(true)
  category    Category @relation(fields: [categoryId], references: [id])
  jobs        Job[]

  @@map("sub_categories")
}

model Blog {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String
  description String?
  excerpt     String?
  coverImage  String?
  tags        String[]  @default([])
  category    String?
  authorId    String?
  authorName  String?
  authorImage String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blogs")
}

model Subscription {
  id                String             @id @default(uuid())
  name              String
  price             String
  discount          String
  isRecomended      Boolean            @default(false)
  featured          String[]           @default([])
  isActive          Boolean            @default(true)
  status            Boolean            @default(true)
  description       String?
  isDeleted         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  duration          String
  slug              String             @unique
  activeDays        Int
  users             User[]
  payments          Payment[]
  subscriptionEarns SubscriptionEarn[]

  @@map("subscriptions")
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  parentId  String?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id])
  children  Folder[] @relation("FolderToFolder")
  images    Image[]

  @@map("folders")
}

model Image {
  id        String   @id @default(uuid())
  name      String
  url       String
  folderId  String?
  slug      String   @unique
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  folder    Folder?  @relation(fields: [folderId], references: [id])

  @@map("images")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MAINTAINER
  OWNER
  USER
  WORKER
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model Job {
  id                   String        @id @default(uuid())
  title                String
  slug                 String        @unique
  company              String?
  location             String
  type                 String?
  salary               String?
  salaryMin            Float?
  salaryMax            Float?
  negotiable           Boolean?      @default(false)
  logo                 String?
  tags                 String[]      @default([])
  categoryId           String?
  subCategoryId        String?
  categoryName         String?
  shortDescription     String?
  description          String
  responsibilities     String[]      @default([])
  requirements         String[]      @default([])
  benefits             String[]      @default([])
  education            String?
  experience           String?
  vacancy              Int?
  deadline             String?
  jobNature            String?
  gender               String?
  ageRange             String?
  salaryReview         String?
  lunchFacility        String?
  festivalBonus        String?
  workingHours         String?
  weekend              String?
  address              String?
  website              String?
  email                String?
  phone                String?
  founded              String?
  companySize          String?
  industry             String?
  skills               String[]      @default([])
  tools                String[]      @default([])
  languages            String[]      @default([])
  visaSponsorship      Boolean?      @default(false)
  relocationAssistance Boolean?      @default(false)
  remotePolicy         String?
  department           String?
  reportingTo          String?
  teamSize             Int?
  performanceBonus     Boolean?      @default(false)
  healthInsurance      Boolean?      @default(false)
  contactPerson        String?
  mapCoordinates       Json?
  socialMedia          Json?
  ceoName              String?
  applicationLink      String?
  internalId           String?
  referenceCode        String?
  keywords             String[]      @default([])
  metaDescription      String?
  applicationDeadline  String?
  isUrgent             Boolean       @default(false)
  workStartTime        String?
  workTimeLimit        String?
  jobAmount            String?
  jobLocation          Json?
  isPublished          Boolean       @default(false)
  status               Boolean       @default(true)
  isDeleted            Boolean       @default(false)
  applicantsCount      Int           @default(0)
  userId               String
  user                 User          @relation(fields: [userId], references: [id])
  category             Category?     @relation(fields: [categoryId], references: [id])
  subCategory          SubCategory?  @relation(fields: [subCategoryId], references: [id])
  applications         Application[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("jobs")
}

model Application {
  id           String    @id @default(uuid())
  jobId        String
  userId       String
  resume       String?
  coverLetter  String?
  applyNote    String?
  applyComment String?
  applyStatus  String    @default("PENDING")
  isRead       Boolean   @default(false)
  isDeleted    Boolean   @default(false)
  status       Boolean   @default(true)
  job          Job       @relation(fields: [jobId], references: [id])
  user         User      @relation(fields: [userId], references: [id])
  comments     Comment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("applications")
}

model Comment {
  id            String      @id @default(uuid())
  applicationId String
  userId        String
  comment       String
  isDeleted     Boolean     @default(false)
  application   Application @relation(fields: [applicationId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("comments")
}

model Notification {
  id            String   @id @default(uuid())
  userId        String
  type          String
  message       String
  jobId         String?
  applicationId String?
  isRead        Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("notifications")
}
