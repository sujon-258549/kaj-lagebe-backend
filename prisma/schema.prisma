generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AllRole {
  id          String           @id @default(uuid())
  role        String           @unique
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]

  createdById String?
  updatedById String?
  createdBy   User?            @relation("AllRoleCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?            @relation("AllRoleUpdatedBy", fields: [updatedById], references: [id])

  @@map("all_roles")
}

model RolePermission {
  id          String   @id @default(uuid())
  roleId      String
  module      String
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  role        AllRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  //  @@unique([roleId, module])
  @@map("role_permissions")
}

model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  createdById String?
  updatedById String?
  createdBy   User?    @relation("DepartmentCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("DepartmentUpdatedBy", fields: [updatedById], references: [id])

  @@map("departments")
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String
  mobile             String             @unique
  role               AllRole?           @relation(fields: [roleId], references: [id])
  roleId             String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  isActive           Boolean            @default(true)
  isBlocked          Boolean            @default(false)
  isDeleted          Boolean            @default(false)
  isVerified         Boolean            @default(false)
  passwordChangeTime DateTime?
  passwordChanged    Boolean            @default(false)
  lastLogin          DateTime?          @default(now())
  subscriptionId     String?
  departmentId       String?
  loginCount         Int                @default(0)
  loginTryCount      Int                @default(0)
  loginTryTime       DateTime?          @default(now())
  address            Address?
  profile            Profile?
  subscriptionEarns  SubscriptionEarn[]
  subscription       Subscription?      @relation(fields: [subscriptionId], references: [id])
  department         Department?        @relation(fields: [departmentId], references: [id])
  workInfo           WorkInfo?
  jobs               Job[]
  applications       Application[]
  comments           Comment[]
  notifications      Notification[]
  payments           Payment[]
  lastFollowUp       DateTime?
  followUpHistory    FollowUpHistory[]
  blogs              Blog[]
  siteSettingsUpdated SiteSetting[] @relation("SiteSettingUpdatedBy")
  siteSettingHistories SiteSettingHistory[]
  categoriesCreated    Category[]           @relation("CategoryCreatedBy")
  categoriesUpdated    Category[]           @relation("CategoryUpdatedBy")
  categoryHistories    CategoryHistory[]
  
  // New Audit Relations
  rolesCreated         AllRole[]            @relation("AllRoleCreatedBy")
  rolesUpdated         AllRole[]            @relation("AllRoleUpdatedBy")
  departmentsCreated   Department[]         @relation("DepartmentCreatedBy")
  departmentsUpdated   Department[]         @relation("DepartmentUpdatedBy")
  configsCreated       SystemConfig[]       @relation("SystemConfigCreatedBy")
  configsUpdated       SystemConfig[]       @relation("SystemConfigUpdatedBy")
  subCategoriesCreated SubCategory[]        @relation("SubCategoryCreatedBy")
  subCategoriesUpdated SubCategory[]        @relation("SubCategoryUpdatedBy")
  workTypesCreated     WorkType[]           @relation("WorkTypeCreatedBy")
  workTypesUpdated     WorkType[]           @relation("WorkTypeUpdatedBy")
  blogsUpdated         Blog[]               @relation("BlogUpdatedBy")
  subscriptionsCreated Subscription[]       @relation("SubscriptionCreatedBy")
  subscriptionsUpdated Subscription[]       @relation("SubscriptionUpdatedBy")
  jobsUpdated          Job[]                @relation("JobUpdatedBy")
  
  foldersCreated       Folder[]             @relation("FolderCreatedBy")
  foldersUpdated       Folder[]             @relation("FolderUpdatedBy")
  imagesCreated        Image[]              @relation("ImageCreatedBy")
  imagesUpdated        Image[]              @relation("ImageUpdatedBy")
  galleriesCreated     Gallery[]            @relation("GalleryCreatedBy")
  galleriesUpdated     Gallery[]            @relation("GalleryUpdatedBy")

  @@map("users")
}

model FollowUpHistory {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  subject String
  content String
  sentAt  DateTime @default(now())

  @@map("follow_up_history")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String?
  updatedById String?
  createdBy   User?    @relation("SystemConfigCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("SystemConfigUpdatedBy", fields: [updatedById], references: [id])

  @@map("system_configs")
}

model SiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String?
  value       Json?
  imageId     String?
  image       Image?   @relation(fields: [imageId], references: [id])
  group       String   @default("general")
  type        String   @default("text")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Audit fields
  updatedById String?
  updatedBy   User?                @relation("SiteSettingUpdatedBy", fields: [updatedById], references: [id])
  histories   SiteSettingHistory[]

  @@map("site_settings")
}

model SiteSettingHistory {
  id            String      @id @default(uuid())
  siteSettingId String
  siteSetting   SiteSetting @relation(fields: [siteSettingId], references: [id], onDelete: Cascade)
  oldValue      Json?
  newValue      Json?
  updatedById   String?
  updatedBy     User?       @relation(fields: [updatedById], references: [id])
  createdAt     DateTime    @default(now())

  @@map("site_setting_histories")
}

model Profile {
  id            String      @id @default(uuid())
  mobile        String      @unique
  name          String?
  gender        Gender?
  age           Int?
  dob           DateTime?
  bloodGroup    BloodGroup?
  photoId       String?
  profilePhoto  Image?      @relation("ProfilePhoto", fields: [photoId], references: [id])
  photo         String?
  nid           String?
  nidPhoto      String[]    @default([])
  nidPhotos     Image[]     @relation("NidPhotos")
  emailVerified Boolean     @default(false)
  phoneVerified Boolean     @default(false)
  nidVerified   Boolean     @default(false)
  serialId      String?
  user          User        @relation(fields: [mobile], references: [mobile])
}

model Address {
  id       String  @id @default(uuid())
  mobile   String  @unique
  division String?
  district String?
  upazila  String?
  address  String?
  user     User    @relation(fields: [mobile], references: [mobile])

  @@map("addresses")
}

model WorkInfo {
  id                 String        @id @default(uuid())
  mobile             String        @unique
  // Many-to-Many relation with SubCategory
  subCategories      SubCategory[]
  experience         String?
  workType           String?
  workTypes          WorkType[]
  workStartTime      String?
  workTimeLimit      String?
  availableTime      String?
  isDeleted          Boolean       @default(false)
  isBlocked          Boolean       @default(false)
  passwordChangeTime DateTime?
  passwordChanged    Boolean       @default(false)
  verified           Boolean       @default(false)
  user               User          @relation(fields: [mobile], references: [mobile])

  @@map("work_infos")
}

model SubscriptionEarn {
  id             String       @id @default(uuid())
  userId         String
  subscriptionId String
  amount         String
  expireAt       DateTime
  isActive       Boolean      @default(true)
  isExpired      Boolean      @default(false)
  renewAt        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id])
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("subscription_earns")
}

model Payment {
  id                 String        @id @default(cuid())
  transactionId      String        @unique
  amount             Float
  status             PaymentStatus @default(PENDING)
  paymentMethod      String?
  userId             String
  subscriptionId     String
  user               User          @relation(fields: [userId], references: [id])
  subscription       Subscription  @relation(fields: [subscriptionId], references: [id])
  paymentGatewayData Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("payments")
}

model Otp {
  id        String   @id @default(uuid())
  email     String   @unique
  otpToken  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otps")
}

model Category {
  id            String        @id @default(uuid())
  icon          String?
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  name          String
  slug          String        @unique
  status        Boolean       @default(true)
  subCategories SubCategory[]
  jobs          Job[]
  imageId       String?
  image         Image?            @relation(fields: [imageId], references: [id])

  // Audit fields
  createdById String?
  updatedById String?
  createdBy   User?             @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?             @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])
  histories   CategoryHistory[]

  @@map("categories")
}

model CategoryHistory {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  oldData    Json?
  newData    Json?
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  createdAt  DateTime @default(now())

  @@map("category_histories")
}

model SubCategory {
  id          String     @id @default(uuid())
  name        String
  categoryId  String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  description String?
  icon        String?
  slug        String     @unique
  status      Boolean    @default(true)
  category    Category   @relation(fields: [categoryId], references: [id])
  jobs          Job[]
  workInfos     WorkInfo[]
  imageId       String?
  image         Image?     @relation(fields: [imageId], references: [id])

  createdById String?
  updatedById String?
  createdBy   User?    @relation("SubCategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("SubCategoryUpdatedBy", fields: [updatedById], references: [id])

  @@map("sub_categories")
}

model WorkType {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workInfos   WorkInfo[]

  createdById String?
  updatedById String?
  createdBy   User?      @relation("WorkTypeCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?      @relation("WorkTypeUpdatedBy", fields: [updatedById], references: [id])

  @@map("work_types")
}

model Blog {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String
  description String?
  excerpt     String?
  coverId     String?
  cover       Image?    @relation("CoverPhoto", fields: [coverId], references: [id])
  tags        String[]  @default([])
  category    String?
  authorName  String?
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id])
  updatedById String?
  updatedBy   User?     @relation("BlogUpdatedBy", fields: [updatedById], references: [id])
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blogs")
}

model Subscription {
  id                String             @id @default(uuid())
  name              String
  price             String
  discount          String
  isRecomended      Boolean            @default(false)
  featured          String[]           @default([])
  isActive          Boolean            @default(true)
  status            Boolean            @default(true)
  description       String?
  isDeleted         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  duration          String
  slug              String             @unique
  activeDays        Int
  users             User[]
  payments          Payment[]
  subscriptionEarns SubscriptionEarn[]

  createdById String?
  updatedById String?
  createdBy   User?         @relation("SubscriptionCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?         @relation("SubscriptionUpdatedBy", fields: [updatedById], references: [id])

  @@map("subscriptions")
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  parentId  String?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id])
  children  Folder[] @relation("FolderToFolder")
  images    Image[]

  createdById String?
  updatedById String?
  createdBy   User?    @relation("FolderCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("FolderUpdatedBy", fields: [updatedById], references: [id])

  @@map("folders")
}

model Image {
  id                   String    @id @default(uuid())
  name                 String
  url                  String
  folderId             String?
  slug                 String    @unique
  status               Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  folder               Folder?   @relation(fields: [folderId], references: [id])
  profilePhotoProfiles Profile[] @relation("ProfilePhoto")
  nidPhotoProfiles     Profile[] @relation("NidPhotos")
  blogs                Blog[]    @relation("CoverPhoto")
  siteSettings         SiteSetting[]
  categories           Category[]
  subCategories        SubCategory[]
  projects             Project[] @relation("ProjectImage")
  galleries            Gallery[] @relation("GalleryImage")

  createdById String?
  updatedById String?
  createdBy   User?    @relation("ImageCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("ImageUpdatedBy", fields: [updatedById], references: [id])

  @@map("images")
}

model Project {
  id          String   @id @default(uuid())
  category    String
  title       String
  slug        String   @unique
  description String?
  content     String?
  image       String
  imageId     String?
  imageRel    Image?   @relation("ProjectImage", fields: [imageId], references: [id])
  number      String
  status      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MAINTAINER
  OWNER
  USER
  WORKER
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model Job {
  id                   String        @id @default(uuid())
  title                String
  slug                 String        @unique
  company              String?
  location             String
  type                 String?
  salary               String?
  salaryMin            Float?
  salaryMax            Float?
  negotiable           Boolean?      @default(false)
  logo                 String?
  tags                 String[]      @default([])
  categoryId           String?
  subCategoryId        String?
  categoryName         String?
  shortDescription     String?
  description          String
  responsibilities     String[]      @default([])
  requirements         String[]      @default([])
  benefits             String[]      @default([])
  education            String?
  experience           String?
  vacancy              Int?
  deadline             String?
  jobNature            String?
  gender               String?
  ageRange             String?
  salaryReview         String?
  lunchFacility        String?
  festivalBonus        String?
  workingHours         String?
  weekend              String?
  address              String?
  website              String?
  email                String?
  phone                String?
  founded              String?
  companySize          String?
  industry             String?
  skills               String[]      @default([])
  tools                String[]      @default([])
  languages            String[]      @default([])
  visaSponsorship      Boolean?      @default(false)
  relocationAssistance Boolean?      @default(false)
  remotePolicy         String?
  department           String?
  reportingTo          String?
  teamSize             Int?
  performanceBonus     Boolean?      @default(false)
  healthInsurance      Boolean?      @default(false)
  contactPerson        String?
  mapCoordinates       Json?
  socialMedia          Json?
  ceoName              String?
  applicationLink      String?
  internalId           String?
  referenceCode        String?
  keywords             String[]      @default([])
  metaDescription      String?
  applicationDeadline  String?
  isUrgent             Boolean       @default(false)
  workStartTime        String?
  workTimeLimit        String?
  jobAmount            String?
  jobLocation          Json?
  isPublished          Boolean       @default(false)
  status               Boolean       @default(true)
  isDeleted            Boolean       @default(false)
  applicantsCount      Int           @default(0)
  authorId             String
  user                 User          @relation(fields: [authorId], references: [id])
  updatedById          String?
  updatedBy            User?         @relation("JobUpdatedBy", fields: [updatedById], references: [id])
  category             Category?     @relation(fields: [categoryId], references: [id])
  subCategory          SubCategory?  @relation(fields: [subCategoryId], references: [id])
  applications         Application[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("jobs")
}

model Application {
  id           String    @id @default(uuid())
  jobId        String
  userId       String
  resume       String?
  coverLetter  String?
  applyNote    String?
  applyComment String?
  applyStatus  String    @default("PENDING")
  isRead       Boolean   @default(false)
  isDeleted    Boolean   @default(false)
  status       Boolean   @default(true)
  job          Job       @relation(fields: [jobId], references: [id])
  user         User      @relation(fields: [userId], references: [id])
  comments     Comment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("applications")
}

model Comment {
  id            String      @id @default(uuid())
  applicationId String
  userId        String
  comment       String
  isDeleted     Boolean     @default(false)
  application   Application @relation(fields: [applicationId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("comments")
}

model Notification {
  id            String   @id @default(uuid())
  userId        String
  type          String
  message       String
  jobId         String?
  applicationId String?
  isRead        Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("notifications")
}

model Gallery {
  id          String   @id @default(uuid())
  title       String
  description String?
  image       String
  imageId     String?
  imageRel    Image?   @relation("GalleryImage", fields: [imageId], references: [id])
  number      String
  status      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String?
  updatedById String?
  createdBy   User?    @relation("GalleryCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("GalleryUpdatedBy", fields: [updatedById], references: [id])

  @@map("galleries")
}
