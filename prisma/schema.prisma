datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String
  mobile             String             @unique
  role               Role               @default(USER)
  isBlocked          Boolean            @default(false)
  isDeleted          Boolean            @default(false)
  isVerified         Boolean            @default(false)
  isActive           Boolean            @default(true)
  passwordChanged    Boolean            @default(false)
  passwordChangeTime DateTime?
  lastLogin          DateTime?          @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  subscriptionId     String? // Added for the new subscription relation
  subscription       Subscription?      @relation(fields: [subscriptionId], references: [id])
  subscriptionEarns  SubscriptionEarn[] // Changed to 1-to-many
  profile            Profile?
  address            Address?
  workInfo           WorkInfo?
  blogs              Blog[]
}

model Profile {
  id         String      @id @default(uuid())
  mobile     String      @unique
  user       User        @relation(fields: [mobile], references: [mobile])
  serialId   String?
  name       String?
  gender     Gender?
  age        Int?
  dob        DateTime?
  bloodGroup BloodGroup?
  photo      String?
  nid        String?
  nidPhoto   String[]    @default([])

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)
  nidVerified   Boolean @default(false)
}

model Address {
  id       String  @id @default(uuid())
  mobile   String  @unique
  user     User    @relation(fields: [mobile], references: [mobile])
  division String?
  district String?
  upazila  String?
  address  String?
}

model WorkInfo {
  id                 String    @id @default(uuid())
  mobile             String    @unique
  user               User      @relation(fields: [mobile], references: [mobile])
  idDeleted          Boolean   @default(false)
  isBlocked          Boolean   @default(false)
  passwordChanged    Boolean   @default(false)
  verified           Boolean   @default(false)
  passwordChangeTime DateTime?
  categories         String[]  @default([])
  experience         String?
  workType           String?
  availableTime      String?
}

model SubscriptionEarn {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  subscriptionId String
  amount         String
  expireAt       DateTime
  isActive       Boolean   @default(true)
  isExpired      Boolean   @default(false)
  renewAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Otp {
  id        String   @id @default(uuid())
  email     String   @unique
  otpToken  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id            String        @id @default(uuid())
  name          String
  icon          String?
  slug          String        @unique
  status        Boolean       @default(true)
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subCategories SubCategory[]
}

model SubCategory {
  id          String   @id @default(uuid())
  name        String
  categoryId  String
  slug        String   @unique
  status      Boolean  @default(true)
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  icon        String?

  @@map("sub_categories")
}

model Blog {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String
  description String?
  excerpt     String?
  coverImage  String?
  tags        String[]  @default([])
  category    String?
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id])
  authorName  String?
  authorImage String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Subscription {
  id           String   @id @default(uuid())
  name         String
  price        String
  slug         String   @unique
  discount     String
  isRecomended Boolean  @default(false)
  featured     String[] @default([])
  isActive     Boolean  @default(true)
  status       Boolean  @default(true)
  description  String?
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  duration     String
  users        User[]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MAINTAINER
  OWNER
  USER
  WORKER
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}
